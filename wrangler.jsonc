{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wispy-cloud-0978",
  "main": "./src/cloudflare-entry.js",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": {
    "required": [
      "SESSION_SECRET",
      "NOTES_KEY_ENCRYPTION_SECRET",
      "HERMES_CHAT_AGENT_SECRET"
    ]
  },
  "vars": {
    "HERMES_CHAT_PROFILES": "primary:Hermes 主助手,personal:Hermes 个人助手",
    "HERMES_CHAT_CLOUD_RETENTION_DAYS": "30"
  },
  "routes": [
    {
      "pattern": "superstar1014.qzz.io",
      "custom_domain": true
    },
    {
      "pattern": "h.superstar1014.qzz.io",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "BLOG_DB",
      "database_name": "superstar1014-blog",
      "database_id": "b91cb125-571f-429c-b99e-ac54ae56f4bc",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NOTE_ATTACHMENTS",
      "bucket_name": "notes"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "HERMES_CHAT_ROOMS",
        "class_name": "HermesChatRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-hermes-chat-room",
      "new_sqlite_classes": ["HermesChatRoom"]
    }
  ],
  "ratelimits": [
    {
      "name": "IP_INFO_CLIENT_RATE_LIMITER",
      "namespace_id": "1014001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "IP_INFO_IP_RATE_LIMITER",
      "namespace_id": "1014002",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "AUTH_LOGIN_RATE_LIMITER",
      "namespace_id": "1014003",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
